# ruc-checker — variables de entorno
# Copiar a .env (NUNCA commitear .env real — ya está en .gitignore raíz)

# Base de datos del marketplace (misma BD que usa el backend Laravel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=db-lyriumv1

# Ruta al binario de Chromium/Chrome que usará Puppeteer.
# En Linux ARM64 (Oracle Cloud) el Chrome que descarga Puppeteer por defecto
# es x86-64 y no corre — hay que usar el Chromium del sistema:
#   sudo apt install chromium-browser
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# En Windows/local, dejar vacío para que Puppeteer use el que descargó solo.
PUPPETEER_EXECUTABLE_PATH=

# Token de apisperu.com (plan B de verificación de RUC cuando SUNAT bloquea
# el scraping por WAF). Generar cuenta gratuita en https://apisperu.com/
APISPERU_TOKEN=

# SMTP para el correo de diagnóstico de /enviar-diagnostico (opcional,
# si se deja vacío usa el default localhost:2525 sin auth, no funcional)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@lyrium.com
